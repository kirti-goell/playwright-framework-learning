Complete Example

import { test, expect }
from '@playwright/test';

test('API Assertions',
async ({ request }) => {

const response =
await request.get(
'https://jsonplaceholder.typicode.com/posts/1'
);

expect(response.status())
.toBe(200);

const body =
await response.json();

expect(body.id)
.toBe(1);

expect(body)
.toHaveProperty('title');

expect(body.title)
.toBeDefined();

expect(body.title.length)
.toBeGreaterThan(0);

const headers =
response.headers();

expect(headers['content-type'])
.toContain('application/json');

});

