// # Difference Between for and for...of

// for Loop:

// const users = ['A','B','C'];

// for(let i = 0; i < users.length; i++) {
//     console.log(users[i]);
// }

// Uses indexes.

// --------------------------------------------------

// for...of Loop:

// for(const user of users) {
//     console.log(user);
// }

// Directly gives values.

// Preferred because it is cleaner and easier to read.

// --------------------------------------------------

// # 3. while Loop

// Runs as long as a condition remains true.

// Syntax:

// while(condition) {

// }

// Example:

// let i = 1;

// while(i <= 5) {

//     console.log(i);

//     i++;
// }

// Output:

// 1
// 2
// 3
// 4
// 5

// --------------------------------------------------

// ## How It Works

// i = 1
// ↓
// Condition checked
// ↓
// Code executes
// ↓
// i increases
// ↓
// Condition checked again
// ↓
// Repeat

// --------------------------------------------------

// # Infinite Loop

// Wrong Example:

// let i = 1;

// while(i <= 5) {
//     console.log(i);
// }

// Problem:

// i never changes.

// The condition remains true forever.

// --------------------------------------------------

// Correct Example:

// let i = 1;

// while(i <= 5) {

//     console.log(i);

//     i++;
// }

// --------------------------------------------------

// # Which Loop Should Be Used?

// Use for Loop

// When number of iterations is known.

// Example:

// for(let i = 1; i <= 10; i++)

// --------------------------------------------------

// Use for...of Loop

// When working with arrays.

// Example:

// for(const user of users)

// Most commonly used in Playwright.

// --------------------------------------------------

// Use while Loop

// When number of iterations is unknown.

// Example:

// while(condition)

// Less common in Playwright automation.

